{"stream":"email_templates","data":{"id":4071603003,"name":"Default Agency Job Assignment Notification","default":true,"updated_at":"2020-11-18T14:09:07.667Z","created_at":"2020-11-18T14:09:07.667Z","description":"This template is used when an agency recruiter is added to a job","body":null,"html_body":"<p>Hi,</p>\n\n<p>{{MY_FULL_NAME}} from {{COMPANY}} has assigned you to the {{JOB_NAME}} job. You can now view this job and submit candidates to it via the agency portal.</p>\n\n<p>\n  Log in here to get started: <a href=\"http://app.greenhouse.io\">app.greenhouse.io</a>\n</p>\n\n<p>\n  <i>The Greenhouse Team</i><br/>\n  <a href=\"http://app.greenhouse.io\">app.greenhouse.io</a>\n</p>\n\n<p>\n  <small>\u00a9 2020 Greenhouse / 18 West 18th Street, 11th Floor, New York, NY 10011, USA</small>\n</p>"},"emitted_at":1691572593898}
