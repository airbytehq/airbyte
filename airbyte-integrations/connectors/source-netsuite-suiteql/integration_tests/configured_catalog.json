{
  "streams": [
    {
      "stream": {
        "name": "transaction",
        "json_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": ["null", "string"]
            },
            "lastmodifieddate": {
              "type": ["null", "date-time"]
            }
          }
        },
        "supported_sync_modes": ["full_refresh"]
      },
      "sync_mode": "full_refresh",
      "destination_sync_mode": "append"
    }
  ]
}
