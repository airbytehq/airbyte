{
  "streams": [
    {
      "stream": {
        "name": "customers",
        "json_schema": {
          "type": "object",
          "properties": {
            "country": {
              "type": "string"
            },
            "tier": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "_id": {
              "type": "string"
            },
            "seats": {
              "type": "number"
            },
            "_ab_cdc_updated_at": {
              "type": "string"
            },
            "_ab_cdc_deleted_at": {
              "type": "string"
            },
            "_ab_cdc_cursor": {
              "type": "number",
              "airbyte_type": "integer"
            }
          }
        },
        "supported_sync_modes": ["full_refresh", "incremental"],
        "source_defined_cursor": true,
        "default_cursor_field": ["_ab_cdc_cursor"],
