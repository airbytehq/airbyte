                "string"
              ]
            },
            "namespace_name": {
              "type": [
                "null",
                "string"
              ]
            },
            "namespace_type": {
              "type": [
                "null",
                "string"
              ]
            },
            "entry_type": {
              "type": "string",
              "enum": [
                "file",
                "folder",
                "deleted"
              ]
            },
            "operation": {
              "type": "string",
              "enum": [
                "upsert",
                "delete"
              ]
            },
            "id": {
              "type": [
                "null",
                "string"
              ]
            },
            "name": {
              "type": "string"
            },
            "path_lower": {
              "type": [
                "null",
                "string"
              ]
            },
            "path_display": {
              "type": [
                "null",
                "string"
              ]
            },
            "rev": {
              "type": [
                "null",
                "string"
              ]
            },
            "client_modified": {
