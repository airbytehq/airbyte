{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acl_key",
    "resource_id",
    "resource_type",
    "principal_type"
  ],
  "properties": {
    "acl_key": {"type": "string"},
    "namespace_id": {"type": ["null", "string"]},
    "namespace_name": {"type": ["null", "string"]},
    "namespace_type": {"type": ["null", "string"]},
    "resource_id": {"type": "string"},
    "resource_type": {"type": "string", "enum": ["shared_folder"]},
    "path_lower": {"type": ["null", "string"]},
    "path_display": {"type": ["null", "string"]},
    "principal_type": {"type": "string", "enum": ["user", "group", "invitee", "other"]},
    "principal_id": {"type": ["null", "string"]},
    "principal_email": {"type": ["null", "string"]},
    "principal_display_name": {"type": ["null", "string"]},
    "access_level": {"type": ["null", "string"]},
    "is_inherited": {"type": ["null", "boolean"]},
    "is_external": {"type": ["null", "boolean"]}
  }
}
