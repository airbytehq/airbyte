              "examples" : [ "12345678-1234-1234-1234-123456789012" ],
              "airbyte_secret" : false
            },
            "azure_client_id" : {
              "type" : "string",
              "description" : "The Azure Active Directory (Entra ID) client ID. Required for Entra ID authentication.",
              "title" : "Azure Client ID",
              "examples" : [ "87654321-4321-4321-4321-210987654321" ],
              "airbyte_secret" : false
            },
            "azure_client_secret" : {
              "type" : "string",
              "description" : "The Azure Active Directory (Entra ID) client secret. Required for Entra ID authentication.",
              "title" : "Azure Client Secret",
              "examples" : [ "your-client-secret" ],
              "airbyte_secret" : true,
              "always_show" : true
            },
            "bucket_path" : {
              "type" : "string",
              "description" : "All files in the container will be prefixed by this.",
              "title" : "Prefix Path in the Container"
            },
            "format" : {
              "oneOf" : [ {
                "title" : "CSV: Comma-Separated Values",
                "type" : "object",
                "additionalProperties" : true,
                "properties" : {
                  "format_type" : {
                    "type" : "string",
                    "enum" : [ "CSV" ],
                    "default" : "CSV"
