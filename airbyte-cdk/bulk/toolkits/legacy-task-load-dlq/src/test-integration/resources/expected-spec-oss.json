              "title" : "Shared Access Signature",
              "examples" : [ "sv=2021-08-06&st=2025-04-11T00%3A00%3A00Z&se=2025-04-12T00%3A00%3A00Z&sr=b&sp=rw&sig=abcdefghijklmnopqrstuvwxyz1234567890%2Fabcdefg%3D" ],
              "airbyte_secret" : true,
              "always_show" : true
