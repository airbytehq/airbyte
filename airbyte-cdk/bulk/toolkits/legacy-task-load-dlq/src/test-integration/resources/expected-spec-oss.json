              "title" : "Azure Blob Storage Account Key",
              "examples" : [ "Z8ZkZpteggFx394vm+PJHnGTvdRncaYS+JhLKdj789YNmD+iyGTnG+PV+POiuYNhBg/ACS+LKjd%4FG3FHGN12Nd==" ],
              "airbyte_secret" : true,
              "always_show" : true
