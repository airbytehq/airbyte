#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10,<3.14"
# dependencies = []
# ///

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from collections.abc import Iterable


CONNECTOR_PATH = "airbyte-integrations/connectors"
CONNECTOR_API = "repos/airbytehq/airbyte/contents/" + CONNECTOR_PATH
CONNECTOR_MINIMUM_EXPECTED = 600
BODY_SCAN_LIMIT = 1500
CONNECTOR_PATTERN = re.compile(r"(source|destination)[-_ ][a-z0-9][a-z0-9_-]*", re.IGNORECASE)
FORM_FIELD_PATTERN = re.compile(r"(?im)^###\s*Connector Name\s*$\n\s*(.+?)\s*(?:\n###|\Z)")


def run_gh(*arguments: str) -> str:
    result = subprocess.run(
        ["gh", "api", *arguments],
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout


def connector_names() -> set[str]:
    names = {
        name
        for name in run_gh(
            "--paginate",
            CONNECTOR_API,
            "--jq",
            '.[] | select(.type=="dir") | .name',
        ).splitlines()
        if name
    }
    if len(names) >= CONNECTOR_MINIMUM_EXPECTED:
        return names

    print(
        f"Contents API returned {len(names)} connectors; falling back to git tree API.",
        file=sys.stderr,
    )
    tree = json.loads(
        run_gh(
            "repos/airbytehq/airbyte/git/trees/master?recursive=1",
        )
    )
    prefix = f"{CONNECTOR_PATH}/"
    return {
        entry["path"][len(prefix) :].split("/", 1)[0]
        for entry in tree["tree"]
        if entry.get("type") == "tree" and entry["path"].startswith(prefix) and "/" not in entry["path"][len(prefix) :]
    }


def normalize(value: str) -> str:
    return re.sub(r"[-_ ]+", "-", value.strip("`'\" .,;:()[]{}")).lower()


def longest_connector_match(candidate: str, connectors: Iterable[str]) -> str | None:
    candidate = normalize(candidate)
    for connector in sorted(connectors, key=len, reverse=True):
        normalized_connector = normalize(connector)
        if candidate == normalized_connector or candidate.startswith(f"{normalized_connector}-"):
            return connector
    return None


def label_for(connector: str) -> str:
    connector_type, name = connector.split("-", 1)
    return f"connectors/{connector_type}/{name}"[:50]


def detect_connectors(title: str, body: str, connectors: set[str]) -> list[str]:
    matches: set[str] = set()
    field = FORM_FIELD_PATTERN.search(body)
    if field:
        match = longest_connector_match(field.group(1), connectors)
        if match:
            matches.add(match)

    bounded_body = body[:BODY_SCAN_LIMIT]
    for candidate_match in CONNECTOR_PATTERN.finditer(title + "\n" + bounded_body):
        match = longest_connector_match(candidate_match.group(0), connectors)
        if match:
            matches.add(match)

    return sorted(matches)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--title", default="")
    parser.add_argument("--body", default="")
    parser.add_argument("--connectors-file")
    parser.add_argument("--connectors-only", action="store_true")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if args.connectors_file:
        with open(args.connectors_file, encoding="utf-8") as file:
            connectors = {line.strip() for line in file if line.strip()}
    else:
        connectors = connector_names()

    if args.connectors_only:
        print("\n".join(sorted(connectors)))
        return

    detected = detect_connectors(args.title, args.body, connectors)
    too_many_connectors = len(detected) > 3
    if too_many_connectors:
        print(
            f"Detected {len(detected)} connectors; emitting no labels for a listing/meta issue.",
            file=sys.stderr,
        )
    result = {
        "connectors": [] if too_many_connectors else detected,
        "labels": [] if too_many_connectors else [label_for(name) for name in detected],
    }
    print(json.dumps(result, sort_keys=True))


if __name__ == "__main__":
    main()
